# Copy this file to .env and fill in real values. .env is git-ignored; never commit it.

# --- Postgres (the pgvector container; see RUNNING.md) ---
DB_HOST=127.0.0.1
DB_PORT=5434
DB_NAME=avalon_research
DB_USER=postgres
DB_PASSWORD=change-me
# component1/database.py reads DB_PASS instead of DB_PASSWORD. Keep the two identical.
DB_PASS=change-me

# --- Groq (comma-separated keys from DIFFERENT Groq accounts; the daily token
# limit is per organisation, so keys from one account share one quota) ---
GROQ_API_KEYS=key_from_account_1,key_from_account_2

# --- Optional switches (all default to the behaviour used in the reported experiments) ---
# Seed for the judge's shuffled-transcript pass (any string).
# JUDGE_SHUFFLE_SEED=0
# Set to 0 to score messages WITHOUT telling the judge who won (outcome-leakage test; not used for reported results).
# JUDGE_SEES_OUTCOME=1
# Set to 1 to inject only notes written for the same side (team) or role the agent has in the new episode.
# INJECTION_ROLE_AWARE=0
# team (same side, good/evil) or role (same exact role)
# INJECTION_ROLE_MATCH=team
